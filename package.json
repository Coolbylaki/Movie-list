{
  "name": "movie-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "electron .",
    "build": "node scripts/clean-build.mjs && tsc -b && vite build && tsc -p tsconfig.desktop.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/library.test.ts",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win --dir",
    "verify:desktop": "electron . --verify-settings",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon.ps1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "description": "A personal desktop movie library browser",
  "author": "Coolbylaki",
  "main": "dist-desktop/desktop/main.js",
  "build": {
    "appId": "com.coolbylaki.movielibrary",
    "productName": "Movie Library",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "desktop/preload.cjs",
      "resources/app.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Movie Library"
    }
  }
}
